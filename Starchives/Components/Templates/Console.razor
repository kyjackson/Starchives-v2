@implements IDisposable
@inject IJSRuntime JS

<div class="d-flex justify-content-between align-items-center mb-2">
	<div class="d-flex align-items-center">
		<input id="wrapCheckbox" type="checkbox" @bind="_wrapLines" />
		<label for="wrapCheckbox" class="ms-1 me-3">Wrap lines</label>

		<input id="autoScrollCheckbox" type="checkbox" @bind="_autoScroll" />
		<label for="autoScrollCheckbox" class="ms-1">Auto-scroll</label>
	</div>
	<div class="text-muted small">Showing last @(_logEvents.Count) lines (capped at @MaxLines)</div>
</div>

<div id="log-console-wrapper" class="overflow-auto" style="max-height:60vh;">
	<div id="log-console" class="p-2" style="@(_wrapLines ? "white-space:pre-wrap; word-break:break-word;" : "white-space:pre; overflow-x:auto;")">
		@foreach (var log in _logEvents)
		{
			<div class="log-event p-0 m-0">@log</div>
		}
		<div id="anchor"></div>
	</div>
</div>

@code {
	private const int MaxLines = 10000;
	private List<string> _logEvents = new();
	private Timer? _timer;
	private bool _wrapLines = true;
	private bool _autoScroll = true;

	protected override void OnInitialized()
	{
		// Update logs every second
		_timer = new Timer(UpdateLogs, null, 0, 1000);
	}

	/// <summary>
	/// Updates the logs by retrieving log events from the InMemoryLogSink and capping the buffer.
	/// </summary>
	/// <param name="state">The state object passed to the timer callback.</param>
	private void UpdateLogs(object? state)
	{
		try
		{
			var events = InMemoryLogSink.GetLogEvents().ToList();

			// Keep only the most recent MaxLines entries to cap memory/DOM size.
			if (events.Count > MaxLines)
			{
				_logEvents = events.Skip(events.Count - MaxLines).ToList();
			}
			else
			{
				_logEvents = events;
			}

			// Ensure UI update and optionally auto-scroll after render
			InvokeAsync(async () =>
			{
				StateHasChanged();

				if (_autoScroll)
				{
					try
					{
						// check JS function exists before calling to avoid first-chance exceptions
						var exists = await JS.InvokeAsync<bool>("eval", "typeof scrollAnchorIntoView === 'function'");
						if (exists)
						{
							await JS.InvokeVoidAsync("scrollAnchorIntoView", "anchor");
						}
					}
					catch
					{
						// swallow JS interop errors
					}
				}
			});
		}
		catch
		{
			// Swallow any exceptions from the timer callback to avoid crashing the app.
		}
	}

	public void Dispose()
	{
		_timer?.Dispose();
	}
}
