@page "/admin"
@layout MainLayout
@rendermode InteractiveServer

@using Starchives.Components.Layout
@using Starchives.Components.Templates
@using Starchives.Facades.YouTube
@using Starchives.Models
@using System.Diagnostics
@using Microsoft.EntityFrameworkCore
@using Serilog
@using Caption = Starchives.Models.Caption
@using System.Text.Json
@using System.Text.Json.Serialization

@inject NavigationManager      Navigation
@inject Data.StarchivesContext DbContext
@inject IVideoApiFacade      YouTubeApiFacade
@inject IConfiguration         Configuration



@if (!_isAuthenticated)
{
	<div id="login-panel" class="p-4 mb-4 text-white bg-dark rounded-3">

		<h3>Admin Login</h3>

		<EditForm class="d-flex flex-row justify-content-center" FormName="adminLoginForm" Model="_loginModel" OnValidSubmit="HandleLogin">

			<DataAnnotationsValidator />
			<ValidationSummary />

			<div class="form-group">

				@if (!string.IsNullOrEmpty(_errorMessage))
				{
					<div class="alert alert-danger mx-auto">@_errorMessage</div>
				}

				<InputText id="password" class="form-control p-1 mb-3 col-3" type="password" @bind-Value="@_loginModel.Password" />

				<button id="login-button" class="btn btn-light btn-sm w-100" type="submit">
					<h5 id="login-button-label" class="heading-md">Login</h5>
				</button>

			</div>

		</EditForm>

	</div>
}
else
{
	<div id="admin-panel" class="d-flex bg-dark rounded-3 justify-content-between">
		<div id="updates-pane" class="d-flex flex-column col-2 p-4">
			<h4>DB Updates</h4>
			<div id="videos-pane" class="p-4 text-white">
				<h5>Videos</h5>
				<p>Last Update: @GetLastUpdateDisplay("videos")</p>
				@* button for updating videos *@
				<button id="button-update-videos" class="btn btn-light btn-sm" @onclick="UpdateVideos">
					<h5 id="button-update-videos-label" class="heading-md">Update</h5>
				</button>
				<br/>
			</div>

			<div id="captions-pane" class="p-4 text-white">
				<h5>Captions</h5>
				<p>Last Update: @GetLastUpdateDisplay("captions")</p>
				@* button for updating captions *@
				<button id="button-update-captions" class="btn btn-light btn-sm" @onclick="UpdateCaptions">
					<h5 id="button-update-captions-label" class="heading-md">Update</h5>
				</button>
				<br/>
			</div>

			<div id="docs-pane" class="p-4 text-white">
				<h5>Documents</h5>
				<p>Last Update: @GetLastUpdateDisplay("documents")</p>
				@* button for updating monthly reports and design docs *@
				<button id="button-update-docs" class="btn btn-light btn-sm" @onclick="UpdateDocuments">
					<h5 id="button-update-docs-label" class="heading-md">Update</h5>
				</button>
				<br/>
			</div>
		</div>

		<div class="divider vr py-4 my-4"></div>

		<div id="logs-pane" class="d-flex flex-column col-10 p-4">
			<h4>Logs</h4>
			@* Console component should handle all the logic for retrieving and displaying logs *@
			<Console />
		</div>
	</div>
}




@code {

	private bool       _isAuthenticated = false;
	private LoginModel _loginModel      = new();
	private string?    _errorMessage;
	private string?    _adminPassword;
    private string?    _channelId;
    private string?    _apiKey;

	// cache triggers keyed by trigger key (videos, captions, documents)
	private Dictionary<string, AdminUpdateTrigger> _triggers = new(StringComparer.OrdinalIgnoreCase);


	protected override async Task OnInitializedAsync()
	{
		// Read from global config (e.g., appsettings.json, appsettings.Development.json, or environment variables)
		_adminPassword = Configuration["AdminPassword"];
        _channelId     = Configuration["ChannelId"];
        _apiKey        = Configuration["YouTubeApiKey"];

		if (string.IsNullOrEmpty(_adminPassword))
		{
			_errorMessage = "Admin password is not set.";
			return;
		}

		// Attempt to load existing triggers if DB is reachable; swallow errors so page still loads
		try
		{
			await LoadTriggersAsync();
		}
		catch (Exception ex)
		{
			Log.Warning(ex, "Failed to load admin update triggers on init.");
		}

		if (_isAuthenticated)
		{
			//await UpdateDb();
		}
	}



	/// <summary>
	/// Handles the login form submission for the admin console.
	/// </summary>
	private async Task HandleLogin()
	{
		Debug.Print($"Password Entered: {_loginModel.Password}");

		if (_loginModel.Password == _adminPassword)
		{
			_isAuthenticated = true;
            _errorMessage    = string.Empty;

			// load triggers after successful login so the UI updates immediately
			try
			{
				await LoadTriggersAsync();
			}
			catch (Exception ex)
			{
				Log.Warning(ex, "Failed to load admin update triggers after login.");
			}
        }
		else
		{
			_errorMessage = "Invalid password.";
		}
	}



	private string GetLastUpdateDisplay(string key)
	{
		if (_triggers.TryGetValue(key, out var trigger) && trigger.LastTriggered.HasValue)
		{
			// show server local time with offset
			var local = trigger.LastTriggered.Value.ToLocalTime();
			return local.ToString("yyyy-MM-dd HH:mm:ss zzz");
		}
		return "Never";
	}


	private async Task LoadTriggersAsync()
	{
		var list = await DbContext.AdminUpdateTriggers.ToListAsync();
		_triggers = list.ToDictionary(t => t.TriggerKey ?? string.Empty, StringComparer.OrdinalIgnoreCase);
		StateHasChanged();
	}


	private async Task UpdateTriggerAsync(string key, bool success, object? detailsObj = null)
	{
		// Ensure a trigger row exists and update it
		var trigger = await DbContext.AdminUpdateTriggers.SingleOrDefaultAsync(t => t.TriggerKey == key);
		if (trigger == null)
		{
			trigger = new AdminUpdateTrigger
			{
				TriggerKey = key,
				Description = key
			};
			await DbContext.AdminUpdateTriggers.AddAsync(trigger);
		}

		trigger.LastTriggered = DateTimeOffset.UtcNow;
		trigger.LastStatus = success ? "success" : "failed";
		trigger.LastUser = Environment.UserName;
		trigger.UpdatedAt = DateTimeOffset.UtcNow;

		if (detailsObj is not null)
		{
			var json = JsonSerializer.Serialize(detailsObj);
			trigger.Details = JsonDocument.Parse(json);
		}
		else
		{
			trigger.Details = null;
		}

		await DbContext.SaveChangesAsync();

		// update cache
		_triggers[key] = trigger;
		StateHasChanged();
	}



	/// <summary>
	/// Retrieves all videos from the Star Citizen YouTube channel, then updates existing videos and inserts new videos into the Starchives database.
	/// </summary>
	/// <returns></returns>
	private async Task UpdateVideos()
	{
		var startTime = DateTime.UtcNow;
		Log.Information($"Started updating videos");

		var addedCount = 0;
		var processedCount = 0;

		try
		{
			var youtubeService = YouTubeApiFacade.GetYouTubeService();
			var rsiChannel     = await YouTubeApiFacade.GetChannel(youtubeService)!;
			var rsiUploadIds   = await YouTubeApiFacade.GetUploadIds(youtubeService, rsiChannel);
			var rsiUploads     = await YouTubeApiFacade.GetUploadDataByIds(youtubeService, rsiUploadIds);

			var videosToUpsert = new List<Video>();
			foreach (var video in rsiUploads)
			{
				// Ensure UTC DateTime for timestamptz
				var publishedOffset = video.Snippet.PublishedAtDateTimeOffset;
				if (publishedOffset is null)
				{
					// Skip any unexpected nulls to avoid Unspecified/invalid writes
					continue;
				}

				var dbVideo = new Video
				{
					VideoId      = video.Id,
					PublishedAt  = publishedOffset.Value.UtcDateTime, // <- UTC, Kind=Utc
					ChannelId    = _channelId,
					Title        = video.Snippet.Title,
					Description  = video.Snippet.Description ?? "N/A",
					Duration     = video.ContentDetails.Duration,
					ViewCount    = (long?)video.Statistics.ViewCount    ?? 0,
					LikeCount    = (long?)video.Statistics.LikeCount    ?? 0,
					CommentCount = (long?)video.Statistics.CommentCount ?? 0,
					EmbedHtml    = video.Player.EmbedHtml               ?? ""
				};

				videosToUpsert.Add(dbVideo);
			}

			// Upsert using EF Core (no BulkExtensions)
			var ids = videosToUpsert.Select(v => v.VideoId).ToList();

			var existing = await DbContext.Videos
				.Where(v => ids.Contains(v.VideoId))
				.ToDictionaryAsync(v => v.VideoId);

			var toAdd = new List<Video>();

			foreach (var v in videosToUpsert)
			{
				if (existing.TryGetValue(v.VideoId, out var ev))
				{
					ev.PublishedAt  = v.PublishedAt; // already UTC
					ev.ChannelId    = v.ChannelId;
					ev.Title        = v.Title;
					ev.Description  = v.Description;
					ev.Duration     = v.Duration;
					ev.ViewCount    = v.ViewCount;
					ev.LikeCount    = v.LikeCount;
					ev.CommentCount = v.CommentCount;
					ev.EmbedHtml    = v.EmbedHtml;
				}
				else
				{
					toAdd.Add(v);
				}
			}

			if (toAdd.Count > 0)
			{
				await DbContext.Videos.AddRangeAsync(toAdd);
				addedCount = toAdd.Count;
			}

			await DbContext.SaveChangesAsync();

			processedCount = videosToUpsert.Count;

			var elapsedTime = DateTime.UtcNow - startTime;
			Log.Information($"Finished updating videos (time elapsed: {elapsedTime:g})");

			// update trigger as success
			await UpdateTriggerAsync("videos", true, new { elapsedSeconds = (DateTime.UtcNow - startTime).TotalSeconds, added = addedCount, processed = processedCount });
		}
		catch (Exception ex)
		{
			Log.Error(ex, "Failed to update videos");
			await UpdateTriggerAsync("videos", false, new { error = ex.Message });
		}
	}



	/// <summary>
	/// Retrieves captions for all videos in the Starchives database that have captions available but not yet stored.
	/// </summary>
	/// <returns></returns>
	private async Task UpdateCaptions()
	{
		var startTime = DateTime.UtcNow;
		Log.Information($"Started updating captions");

		var captionsAdded = 0;
		try
		{
			var videosWithoutCaptions = await DbContext.Videos
				.Where(video => !DbContext.Captions.Any(caption => caption.VideoId == video.VideoId))
				.OrderBy(video => video.PublishedAt)
				.ToListAsync();

			// Insert captions in batches for reasonable performance without BulkExtensions
			const int batchSize = 1000;
			var buffer = new List<Caption>(batchSize);

			var prevAutoDetect = DbContext.ChangeTracker.AutoDetectChangesEnabled;
			DbContext.ChangeTracker.AutoDetectChangesEnabled = false;
			try
			{
				var index = 0;
				foreach (var video in videosWithoutCaptions)
				{
					var captionTrack = await YouTubeApiFacade.GetCaptionTrackByVideoId(video.VideoId);
					if (captionTrack is null) continue;

					foreach (var c in captionTrack.Captions)
					{
						if (c.Text == "\n") continue;

						buffer.Add(new Caption
						{
							VideoId  = video.VideoId,
							Duration = c.Duration,
							Offset   = c.Offset,
							Text     = c.Text
						});

						if (buffer.Count >= batchSize)
						{
							await DbContext.Captions.AddRangeAsync(buffer);
							await DbContext.SaveChangesAsync();
							captionsAdded += buffer.Count;
							buffer.Clear();
						}
					}

					index++;

					Log.Information($"Caption tracks processed: {index}/{videosWithoutCaptions.Count}");
				}

				if (buffer.Count > 0)
				{
					await DbContext.Captions.AddRangeAsync(buffer);
					await DbContext.SaveChangesAsync();
					captionsAdded += buffer.Count;
					buffer.Clear();
				}
			}
			finally
			{
				DbContext.ChangeTracker.AutoDetectChangesEnabled = prevAutoDetect;
			}

			var elapsedTime = DateTime.UtcNow - startTime;
			Log.Information($"Finished updating captions (time elapsed: {elapsedTime:g})");

			await UpdateTriggerAsync("captions", true, new { elapsedSeconds = (DateTime.UtcNow - startTime).TotalSeconds, added = captionsAdded });
		}
		catch (Exception ex)
		{
			Log.Error(ex, "Failed to update captions");
			await UpdateTriggerAsync("captions", false, new { error = ex.Message });
		}
	}



	/// <summary>
	/// Retrieves all monthly reports and design docs from the RSI website, then updates existing documents and inserts new documents into the Starchives database.
	/// </summary>
	/// <returns></returns>
	private async Task UpdateDocuments()
	{
		var startTime = DateTime.UtcNow;
		try
		{
			// TODO: Implement monthly report update
			// TODO: Implement design docs update
			Log.Information($"Documents updated");

			await DbContext.SaveChangesAsync();

			await UpdateTriggerAsync("documents", true, new { elapsedSeconds = (DateTime.UtcNow - startTime).TotalSeconds });
		}
		catch (Exception ex)
		{
			Log.Error(ex, "Failed to update documents");
			await UpdateTriggerAsync("documents", false, new { error = ex.Message });
		}
	}



	public static List<List<string>> SplitList(List<string> source, int chunkSize)
	{
		return source
			   .Select((value, index) => new { value, index })
			   .GroupBy(x => x.index / chunkSize)
			   .Select(g => g.Select(x => x.value).ToList())
			   .ToList();
	}



	public class LoginModel
	{
		public string Password { get; set; }
	}
}
