@page "/"

@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json
@using Starchives.Models
@using Starchives.Components.Templates

@rendermode InteractiveServer

@inject NavigationManager Navigation
@inject HttpClient        Http

<PageTitle>Starchives</PageTitle>

@****************************************@
@* Search Panel (Jumbotron)             *@
@****************************************@
<div id="caption-search-panel" class="searchContainer p-4 mb-4 text-white bg-dark rounded-3">

	<div id="search" class="p-4 container-fluid">
		<form id="searchWindow" @onsubmit="Search">
			<h2 class="display-6 fw heading-lg">Enter Query</h2>
			<p class="small">Simply enter a word or phrase in the search bar below to find every occurrence among all uploads on the Star Citizen Youtube channel.</p>

			@* Search bar and filters switch *@
			<div class="row justify-content-center align-items-center">
				<div class="col-6 my-4">
					<input id="searchBar" type="text" class="form-control text-center" name="query" placeholder="Search..." @bind="Keywords">
				</div>

				<div class="col-1 my-4">
					<div class="form-check form-switch">
						<input id="filterSwitch" class="form-check-input" type="checkbox" role="switch" @bind="FiltersEnabled">
						<label class="form-check-label" for="filterSwitch">Filters</label>
					</div>
				</div>
			</div>

			@if (FiltersEnabled)
			{
				@* Vertical filters *@
				<div class="row justify-content-center">
					<div class="col-12 col-md-6 col-lg-4">
						<div class="d-flex flex-column gap-3">

							@* Published: dual-thumb single-track (MudExtensions MudRangeSlider), 2012 → current year, step 1 *@
							<div class="text-start">
								<label class="form-label m-0">
									Published: <span class="ms-1 text-warning">@PublishedDisplay</span>
								</label>
								<MudRangeSlider T="int"
								                              @bind-Value="_publishedValue"
                                                              @bind-UpperValue="_publishedUpperValue"
                                                              Range="true"
								                              Min="@PublishedMinYear"
								                              Max="@PublishedMaxYear"
								                              Step="1"
                                                              MinDistance="0"
								                              TickMarks="true"
								                              Color="Color.Warning"
                                                              Class="m-0" 
															  Variant="Variant.Filled" />
								<small class="text-secondary">Range: @PublishedMinYear–@PublishedMaxYear</small>
							</div>

							@* Duration: dual-thumb single-track (MudExtensions MudRangeSlider), 0 → 60 (60 means 60+), step 5 *@
							<div class="text-start">
                                <label class="form-label m-0">
                                    Duration: <span class="ms-1 text-warning">@DurationRangeDisplay</span>
                                </label>
                                <MudRangeSlider T="int"
                                                              @bind-Value="@_durationValue"
                                                              @bind-UpperValue="@_durationUpperValue"
                                                              Range="true"
                                                              Min="@DurationMinVal"
                                                              Max="@DurationMaxVal"
                                                              Step="@DurationStep"
															  MinDistance="DurationStep"
                                                              TickMarks="true"
                                                              Color="Color.Warning" 
                                                              Class="m-0"
                                                              Variant="Variant.Filled"/>
                                <small class="text-secondary">Range: 0–60+ minutes (5-minute steps)</small>
                            </div>

							@* Order By: single-thumb slider with 4 discrete options (MudSlider) *@
							<div class="text-start">
								<label class="form-label m-0">
									Order By: <span class="ms-1 text-warning">@OrderByDisplay</span>
								</label>
								<MudSlider T="int"
										   @bind-Value="OrderByIndex"
										   Min="0"
										   Max="3"
                                           Step="1"
                                           TickMarks="true"
										   TickMarkLabels="@_orderByLabels"
										   Immediate="true"
										   Color="Color.Warning"
										   Class="m-0 bs-text" />
							</div>

							@* Ascending checkbox on the right *@
                            <div class="form-check form-check-reverse mt-2 text-end">
                                <label class="form-check-label me-2" for="order">Ascending</label>
                                <input id="order" class="form-check-input" type="checkbox" @bind="IsAscending">
                            </div>

                        </div>
					</div>
				</div>
			}

			@* Search Button *@
			<button id="searchButton" class="btn btn-light btn-lg mt-4" type="submit" disabled="@_isSearchDisabled">

				@if (_isSearchDisabled)
				{
					<span id="loadingIcon" class="spinner-grow spinner-grow-sm me-2" role="status"></span>
				}

				<span id="searchButtonLabel">@_searchButtonLabel</span>
			</button>
		</form>

		@* Search results get displayed inside this div *@
		<div id="resultsContainer" class="mx-auto justify-content-center">
			
			@if (!string.IsNullOrEmpty(_searchResultsMessage))
			{
				<p id="resultHeader" class="mb-0 pt-4 text-center">@((MarkupString)_searchResultsMessage)</p>
			}

			@if (_videoPage != null)
			{
				<div id="results" class="pt-4 d-flex flex-column justify-content-center">

					<SearchResultsNavBar
                        CurrentPage="@_videoPage!.CurrentPage"
                        TotalPages="@_videoPage!.PageCount"
						DisablePrevious="@IsFirstPage"
						DisableNext="@IsLastPage"
						IsLoading="@_isPageLoading"
						OnPrevious="GoToPreviousPage"
						OnNext="GoToNextPage" />

					<div id="resultsAccordion" class="mx-auto w-75 accordion accordion-flush">
					@foreach (var result in _videoPage!.Data)
					{
						<SearchResult Video="@result" Keywords="@Keywords"/>
					}
					</div>

				</div>
			}

		</div>

	</div>

</div>



<!-- Cards for caveats and tips -->
<div class="row align-items-md-stretch">

	<!-- Caveats card -->
	<div class="col-md-6 caveats">
		<div class="h-100 p-5 text-white bg-dark rounded-3">
			<h2 class="heading-md">Caveats</h2>
			<p class="heading-sm-1 text-start">1. <i>Captions are not always accurate.</i></p>
			<p class="ps-5 text-start">
				Due to most of the captions being auto-generated, they are not always accurate. What can be heard in a
				video will sometimes be transcribed as something unexpected by Google's caption transcription
				algorithm. This tends to occur more often in older videos.
			</p>

			<p class="heading-sm-1 text-start">2. <i>Not all searches are conclusive.</i></p>
			<p class="ps-5 text-start">
				Sometimes, a certain word or phrase can be broken up in one video's caption track and not in
				another. This can cause similar search terms to unexpectedly return different results (e.g.,
				"multicrew" and "multi crew" return different results), and in some cases one term might return
				results while a similar term returns none. If either of these occur, try rephrasing your search
				to use a different keyword, or to be less specific.
			</p>

			<p class="heading-sm-1 text-start">3. <i>Auto-generated captions only have English localization.</i></p>
			<p class="ps-5 text-start">
				Unfortunately, auto-generated captions are not available in languages other than English. If you
				are interested in volunteering to transcribe caption tracks for another language, contact me and
				I'll consider all options for adding them to the Starchives database.
			</p>
		</div>
	</div>

	<!-- Tips card -->
	<div class="col-md-6 tips">
		<div class="h-100 p-5 justify-content-left text-white bg-dark rounded-3">
			<h2 class="heading-md">Tips</h2>
			<p class="heading-sm-2 text-start"><i>Try multiple spellings when searching for a name.</i></p>
			<p class="ps-5 text-start">
				Because "Lorville" is an uncommon word, the caption generator has interpreted it
				as "lore ville," "loreville," "lor ville," and more at various occasions, so all three
				of those terms will yield different results. Such is the case for many spoken names,
				especially if they are uncommon.
			</p>

			<p class="heading-sm-2 text-start"><i>Keep the query around three words at most and four characters at least for effective searches.</i></p>
			<p class="ps-5 text-start">
				Caption lines tend to be around 6-12 words long, with the occasional exceptions for fast
				speakers. Using too many words will yield few results, and using too few characters can
				yield not only too many results, but also too many captions.
			</p>

			<p class="heading-sm-2 text-start"><i>Search without a query to get results without captions.</i></p>
			<p class="ps-5 text-start">
				If you want to find videos without getting the captions and slowing the page down too much,
				you can search without a query and use the filters to still get specific groups of videos and
				their other data, such as views and likes.
			</p>

		</div>
	</div>

</div>



@code
{
	// define the search parameters as properties
	private string Keywords      { get; set; } = string.Empty;

	private string SortBy        { get; set; } = "PublishedAt";
	private string SortDirection { get; set; } = "desc";
	private int    PageNumber    { get; set; } = 1;

	// UI state
	private bool   FiltersEnabled     { get; set; } = false;
	private bool   IsAscending        { get; set; } = false;

	private bool         _isSearchDisabled      = false;
	private string       _searchButtonLabel     = "Search Starchives";
	private string       _searchResultsMessage  = string.Empty;
	private VideoPage?   _videoPage;

	// paging helpers
	private bool _isPageNavigation = false;
    private bool _isPageLoading    = false;
	private bool IsFirstPage => (_videoPage?.CurrentPage ?? 1) <= 1;
	private bool IsLastPage  => _videoPage is not null && _videoPage.CurrentPage >= _videoPage.PageCount;

	// ----- Published (Range) -----
	private static int PublishedMinYear => 2012;
	private static int PublishedMaxYear => DateTime.Now.Year;

	private int _publishedValue      = 2012;
	private int _publishedUpperValue = DateTime.Now.Year;
	private string PublishedDisplay => $"{_publishedValue}–{_publishedUpperValue}";

	private int PublishedFromYearInt => _publishedValue;
	private int PublishedToYearInt   => _publishedUpperValue;

	// ----- Duration (Range, 0..60 step 5; 60 -> 60+) -----
    private const int DurationMinVal = 0;
    private const int DurationMaxVal = 60;
    private const int DurationStep   = 5;

    private int _durationValue      = 0;
	private int _durationUpperValue = 60;

	private static string FormatDurationBound(int v) => v >= 60 ? "60+ min" : $"{v} min";
	private string DurationRangeDisplay => $"{FormatDurationBound(_durationValue)} – {FormatDurationBound(_durationUpperValue)}";

	// ----- Order By (single-thumb) -----
	private int OrderByIndex
	{
		get => SortBy switch
		{
			"PublishedAt" => 0,
            "Duration"    => 1,
			"ViewCount"   => 2,
			"LikeCount"   => 3,
			_             => 0
		};
		set
		{
			SortBy = value switch
			{
				0 => "PublishedAt",
                1 => "Duration",
				2 => "ViewCount",
				3 => "LikeCount",
				_ => "PublishedAt"
			};
		}
	}

	private string OrderByDisplay => SortBy switch
	{
		"PublishedAt" => "Date",
        "Duration"    => "Duration",
		"ViewCount"   => "Views",
		"LikeCount"   => "Likes",
		_             => "Date"
	};

	private readonly string[] _orderByLabels = ["Date", "Duration", "Views", "Likes"];



	private async Task GoToPreviousPage()
	{
		if (_videoPage is null || IsFirstPage || _isPageLoading) return;
		_isPageNavigation = true;
		PageNumber        = _videoPage.CurrentPage - 1;
        _isPageLoading    = true;
		await InvokeAsync(StateHasChanged);
		await Search();
	}

	private async Task GoToNextPage()
	{
		if (_videoPage is null || IsLastPage || _isPageLoading) return;
		_isPageNavigation = true;
		PageNumber        = _videoPage.CurrentPage + 1;
        _isPageLoading    = true;
		await InvokeAsync(StateHasChanged);
		await Search();
	}

	private async Task Search()
	{
		SortDirection = IsAscending ? "asc" : "desc";

		if (!_isPageNavigation)
			PageNumber = 1;

		var uri = new UriBuilder(Navigation.BaseUri) { Port = -1 };

		var queryParams = new Dictionary<string, string?>
		{
			["keywords"]     = Keywords ?? string.Empty,
			["publishFrom"]  = PublishedFromYearInt.ToString(),
			["publishTo"]    = PublishedToYearInt.ToString(),
			["durationMin"]  = _durationValue.ToString(),
			["durationMax"]  = _durationUpperValue.ToString(),
			["page"]         = PageNumber.ToString(),
			["pageNumber"]   = PageNumber.ToString()
		};
		if (!string.IsNullOrEmpty(SortBy))        queryParams["sortBy"]        = SortBy;
		if (!string.IsNullOrEmpty(SortDirection)) queryParams["sortDirection"] = SortDirection;

		var qs = QueryString.Create(queryParams);
		uri.Query = qs.HasValue ? qs.Value! : string.Empty;

		try
		{
			var startTime = DateTime.Now;

			if (!_isPageNavigation)
				DisableSearchButton();

			var response = await Http.GetAsync($"api/videos{uri.Query}");

			if (response.IsSuccessStatusCode)
			{
				var responseContent = await response.Content.ReadAsStringAsync();
				_videoPage = JsonConvert.DeserializeObject<VideoPage>(responseContent);

				if (_videoPage is not null && _videoPage.CurrentPage > 0)
					PageNumber = _videoPage.CurrentPage;

				var elapsed = DateTime.Now - startTime;
				_searchResultsMessage = $"Found {_videoPage?.VideoCount} videos containing '{Keywords}' in {elapsed:s\\.ff} seconds";

				if (!_isPageNavigation)
					EnableSearchButton();
				else
					await InvokeAsync(StateHasChanged);
			}
			else
			{
				_searchResultsMessage = "Something went wrong. If this problem persists, try again later or <a href=\"mailto:admin@starchives.org\">contact me</a>.";
			}
		}
		catch (HttpRequestException)
		{
			_searchResultsMessage = "Something went wrong. If this problem persists, try again later or <a href=\"mailto:admin@starchives.org\">contact me</a>.";
		}
		finally
        {
            _isPageNavigation = false;
			_isPageLoading    = false;
			await InvokeAsync(StateHasChanged);
		}
	}

	private void DisableSearchButton()
	{
		_videoPage            = null;
		_searchResultsMessage = string.Empty;
		_isSearchDisabled     = true;
		_searchButtonLabel    = "Searching";
	}

	private void EnableSearchButton()
	{
		_isSearchDisabled  = false;
		_searchButtonLabel = "Search Starchives";
		InvokeAsync(StateHasChanged);
	}

	public class VideoPage
	{
		public int         CurrentPage { get; set; }
		public int         VideoCount  { get; set; }
		public int         PageCount   { get; set; }
		public List<Video> Data        { get; set; }
	}
}
